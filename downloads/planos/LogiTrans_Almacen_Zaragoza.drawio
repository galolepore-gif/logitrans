        </mxCell>
        <mxCell id="c1202" parent="L_txt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#1A1A1A;strokeWidth=3;fillColor=#FFFFFF;spacing=0;overflow=fill;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;height:100%;font-family:Helvetica;font-size:28px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #1A1A1A;padding:10px 16px;background:#1A1A1A;color:#fff&quot;&gt;&lt;div style=&quot;font-size:44px;font-weight:bold;letter-spacing:3px&quot;&gt;LOGITRANS&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Proyecto de infraestructura de red · Ciclo ASIR&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;PLANO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;&lt;b&gt;Planta general · Almacén&lt;/b&gt;&lt;br&gt;Distribución, estanterías, muelles y red&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;EMPLAZAMIENTO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;Nave P3 · PLAZA (Plataforma Logística)&lt;br&gt;50197 Zaragoza&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;SUPERFICIE&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;9.000 m² construidos · 150,00 × 60,00 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;ESCALA&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;Gráfica · 1:200 en A1 (1 px = 2 cm)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;EQUIPO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;Galo Lepore Rossi (Scrum Master)&lt;br&gt;Joan (Product Owner) · Oliver · Robert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;TAREA / SPRINT&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;1.10 · Sprint 1&lt;br&gt;Rev. B · Sprint 2 (1 rack + VLAN 99)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;width:34%;color:#555&quot;&gt;FECHA&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px&quot;&gt;Octubre 2026 · Rev. B: noviembre 2026&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;color:#555&quot;&gt;Nº PLANO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:10px 16px;font-size:40px;font-weight:bold&quot;&gt;LT-AL-01&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
