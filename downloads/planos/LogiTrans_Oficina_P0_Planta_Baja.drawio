        <mxCell id="c717" parent="L_txt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#1A1A1A;strokeWidth=2;fillColor=#FFFFFF;spacing=0;overflow=fill;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;height:100%;font-family:Helvetica;font-size:21px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #1A1A1A;padding:7px 12px;background:#1A1A1A;color:#fff&quot;&gt;&lt;div style=&quot;font-size:30px;font-weight:bold;letter-spacing:2px&quot;&gt;LOGITRANS&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Proyecto de infraestructura de red · Ciclo ASIR&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;PLANO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;&lt;b&gt;Planta Baja (P0) · Oficina central&lt;/b&gt;&lt;br&gt;Acceso, servicios comunes y CPD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;EMPLAZAMIENTO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;One Parc Central · C/ Marroc 33&lt;br&gt;22@ · 08018 Barcelona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;SUPERFICIE&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;1.000 m² construidos · 40,00 × 25,00 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;ESCALA&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;Gráfica · 1:100 en A1 (1 px = 1 cm)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;EQUIPO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;Galo Lepore Rossi (Scrum Master)&lt;br&gt;Joan (Product Owner) · Oliver · Robert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;TAREA / SPRINT&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;1.09 · Sprint 1&lt;br&gt;Rev. B · Sprint 2 (CPD a 1 rack + taller IT)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;width:36%;color:#555&quot;&gt;FECHA&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px&quot;&gt;Octubre 2026 · Rev. B: noviembre 2026&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;color:#555&quot;&gt;Nº PLANO&lt;/td&gt;&lt;td style=&quot;border:1px solid #1A1A1A;padding:7px 12px;font-size:28px;font-weight:bold&quot;&gt;LT-OF-P0 &lt;span style=&quot;font-size:18px;font-weight:normal;color:#555&quot;&gt;· hoja 1 de 4&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
