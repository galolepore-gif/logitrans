        <mxCell id="c718" parent="L_txt" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#1A1A1A;fillColor=#FFFFFF;spacing=0;overflow=fill;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;height:100%;font-family:Helvetica;font-size:19px&quot;&gt;&lt;tr style=&quot;background:#00838F;color:#fff&quot;&gt;&lt;th style=&quot;padding:6px 10px;text-align:left&quot; colspan=&quot;2&quot;&gt;EQUIPAMIENTO DE RED · P0&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Puestos de trabajo con PC + teléfono IP&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold&quot;&gt;30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Puntos de acceso Wi-Fi 6 (PoE+)&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold&quot;&gt;12&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Cajas de suelo (6 × RJ45)&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold&quot;&gt;11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Tomas de pared dobles (incl. 2 del taller IT)&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold&quot;&gt;11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Impresoras / multifunción&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd&quot;&gt;Puertos RJ45 Cat 6A a cablear&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-bottom:1px solid #ddd;text-align:right;font-weight:bold